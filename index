<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#38bdf8">
  <title>DevLexicon - Glossario Tecnico</title>
  <link rel="manifest" href="manifest.json">
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
      --badge: #0369a1;
      --badge-new: #15803d;
      --danger: #ef4444;
      --code-bg: #0b1120;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 2rem 1rem; display: flex; justify-content: center; }
    .container { width: 100%; max-width: 850px; }

    header { text-align: center; margin-bottom: 1.5rem; }
    header h1 { font-size: 2.2rem; color: var(--accent); margin-bottom: 0.3rem; }
    header p { color: var(--text-muted); }

    .api-box {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px;
      padding: 0.8rem 1rem; margin-bottom: 1rem; display: flex; gap: 0.5rem; align-items: center;
    }
    .api-box input {
      flex: 1; padding: 0.4rem 0.6rem; border-radius: 4px; border: 1px solid var(--border);
      background: #0f172a; color: var(--text); outline: none; font-size: 0.85rem;
    }
    .api-box button, .btn-action {
      padding: 0.4rem 0.8rem; background: var(--border); color: var(--text); border: none;
      border-radius: 4px; cursor: pointer; font-size: 0.85rem; transition: background 0.2s;
    }
    .api-box button:hover, .btn-action:hover { background: #475569; }

    .tools-bar {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 1.5rem; background: rgba(30, 41, 59, 0.5); padding: 0.6rem 1rem;
      border-radius: 8px; border: 1px solid var(--border); flex-wrap: wrap; gap: 0.5rem;
    }
    .tools-bar span { font-size: 0.85rem; color: var(--text-muted); }
    .tools-buttons { display: flex; gap: 0.5rem; }

    .search-box { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .search-box input {
      flex: 1; padding: 0.8rem 1rem; border-radius: 8px; border: 1px solid var(--border);
      background: var(--card-bg); color: var(--text); font-size: 1rem; outline: none;
    }
    .search-box input:focus { border-color: var(--accent); }

    .categories-bar {
      display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.8rem; margin-bottom: 1rem;
      scrollbar-width: thin;
    }
    .cat-filter-btn {
      padding: 0.35rem 0.8rem; border-radius: 20px; border: 1px solid var(--border);
      background: var(--card-bg); color: var(--text-muted); cursor: pointer; font-size: 0.8rem;
      white-space: nowrap; transition: all 0.2s;
    }
    .cat-filter-btn.active {
      background: var(--accent); color: var(--bg); border-color: var(--accent); font-weight: 600;
    }

    .view-toggle { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .btn-toggle {
      flex: 1; padding: 0.6rem; border: 1px solid var(--border); background: var(--card-bg);
      color: var(--text-muted); border-radius: 6px; cursor: pointer; font-weight: 600;
      transition: all 0.2s;
    }
    .btn-toggle.active { background: var(--accent); color: var(--bg); border-color: var(--accent); }

    .term-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px;
      padding: 1.5rem; margin-bottom: 1.2rem;
    }
    .card-header {
      display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;
    }
    .term-card h2 { color: var(--accent); font-size: 1.3rem; }
    .btn-delete {
      background: transparent; border: none; color: var(--text-muted); cursor: pointer;
      font-size: 1rem; padding: 0.2rem 0.5rem; border-radius: 4px;
    }
    .btn-delete:hover { color: var(--danger); background: rgba(239, 68, 68, 0.1); }

    .badge-group { display: flex; gap: 0.5rem; margin-bottom: 0.8rem; }
    .category-badge {
      display: inline-block; font-size: 0.75rem; background: var(--badge); color: white;
      padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase; font-weight: 600;
    }
    .new-badge {
      display: inline-block; font-size: 0.75rem; background: var(--badge-new); color: white;
      padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase; font-weight: 600;
    }
    .text-content { line-height: 1.6; color: var(--text); }

    .code-block {
      margin-top: 1rem; background: var(--code-bg); border: 1px solid var(--border);
      border-radius: 6px; padding: 1rem; overflow-x: auto;
    }
    .code-header { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem; font-weight: 700; }
    pre code { font-family: 'Consolas', 'Fira Code', monospace; font-size: 0.9rem; color: #38bdf8; }

    .not-found-box {
      text-align: center; background: var(--card-bg); border: 1px dashed var(--border);
      border-radius: 10px; padding: 2.5rem 1.5rem; margin-top: 1rem;
    }
    .btn-search-web {
      margin-top: 1rem; padding: 0.7rem 1.2rem; background: var(--accent);
      color: var(--bg); border: none; border-radius: 6px; font-weight: 700;
      cursor: pointer; transition: background 0.2s;
    }
    .btn-search-web:hover { background: var(--accent-hover); }
    .spinner { display: inline-block; margin-top: 1rem; color: var(--accent); font-weight: 600; }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>DevLexicon</h1>
    <p>Dizionario di programmazione con auto-apprendimento Web / AI</p>
  </header>

  <div class="api-box">
    <label for="apiKeyInput" style="font-size: 0.85rem; color: var(--text-muted);">Chiave Gemini API:</label>
    <input type="password" id="apiKeyInput" placeholder="Incolla la tua API Key...">
    <button onclick="saveApiKey()">Salva Chiave</button>
  </div>

  <div class="tools-bar">
    <span id="termCount">0 termini memorizzati</span>
    <div class="tools-buttons">
      <button class="btn-action" onclick="exportData()">💾 Esporta Backup</button>
      <button class="btn-action" onclick="document.getElementById('importFile').click()">📂 Importa</button>
      <input type="file" id="importFile" accept=".json" style="display: none;" onchange="importData(event)">
    </div>
  </div>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="Cerca un termine (es. Docker, Webhook, Polymorphism)...">
  </div>

  <div class="categories-bar" id="categoriesBar"></div>

  <div class="view-toggle">
    <button class="btn-toggle active" id="btnSummary" onclick="setViewMode('summary')">Modalità Sintetica</button>
    <button class="btn-toggle" id="btnDetail" onclick="setViewMode('detail')">Modalità Dettagliata</button>
  </div>

  <div id="termsList"></div>
</div>

<script>
  // Registrazione Service Worker per PWA
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./sw.js')
        .then(() => console.log('Service Worker registrato con successo.'))
        .catch(err => console.log('Registrazione Service Worker non riuscita:', err));
    });
  }

  const defaultGlossary = [
    {
      term: "API (Application Programming Interface)",
      category: "Architettura",
      summary: "Insieme di regole e protocolli che permette a due applicazioni software di comunicare tra loro.",
      detail: "Un'interfaccia di programmazione che definisce le modalità con cui diversi componenti software interagiscono senza conoscerne l'implementazione interna.",
      code: `// Chiamata API standard in JavaScript\nfetch('https://api.example.com/data')\n  .then(res => res.json())\n  .then(data => console.log(data));`,
      autoFetched: false
    },
    {
      term: "Recursion (Ricorsione)",
      category: "Algoritmi",
      summary: "Tecnica in cui una funzione chiama se stessa per risolvere un problema dividendolo in sottoproblemi più piccoli.",
      detail: "Un approccio algoritmico in cui una funzione invoca se stessa fino a raggiungere una condizione di arresto definita 'caso base'.",
      code: `function countdown(n) {\n  if (n <= 0) return;\n  console.log(n);\n  countdown(n - 1);\n}`,
      autoFetched: false
    }
  ];

  let glossary = JSON.parse(localStorage.getItem('dev_lexicon_terms')) || defaultGlossary;
  let currentMode = 'summary';
  let selectedCategory = 'ALL';

  const storedKey = localStorage.getItem('gemini_api_key') || '';
  if (storedKey) document.getElementById('apiKeyInput').value = storedKey;

  function saveApiKey() {
    const key = document.getElementById('apiKeyInput').value.trim();
    localStorage.setItem('gemini_api_key', key);
    alert('Chiave API salvata con successo!');
  }

  function setViewMode(mode) {
    currentMode = mode;
    document.getElementById('btnSummary').classList.toggle('active', mode === 'summary');
    document.getElementById('btnDetail').classList.toggle('active', mode === 'detail');
    renderTerms(document.getElementById('searchInput').value);
  }

  function setCategory(cat) {
    selectedCategory = cat;
    renderCategories();
    renderTerms(document.getElementById('searchInput').value);
  }

  function renderCategories() {
    const catBar = document.getElementById('categoriesBar');
    const categories = ['ALL', ...new Set(glossary.map(item => item.category || 'Generale'))];
    
    catBar.innerHTML = categories.map(cat => `
      <button class="cat-filter-btn ${selectedCategory === cat ? 'active' : ''}" 
              onclick="setCategory('${escapeHtml(cat)}')">
        ${cat === 'ALL' ? 'Tutte le Categorie' : escapeHtml(cat)}
      </button>
    `).join('');
  }

  function deleteTerm(termToDelete) {
    if (confirm(`Vuoi eliminare "${termToDelete}"?`)) {
      glossary = glossary.filter(item => item.term !== termToDelete);
      localStorage.setItem('dev_lexicon_terms', JSON.stringify(glossary));
      renderCategories();
      renderTerms(document.getElementById('searchInput').value);
    }
  }

  function exportData() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(glossary, null, 2));
    const a = document.createElement('a');
    a.setAttribute("href", dataStr);
    a.setAttribute("download", `glossario_dev_${new Date().toISOString().slice(0, 10)}.json`);
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function importData(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const imported = JSON.parse(e.target.result);
        if (Array.isArray(imported)) {
          glossary = imported;
          localStorage.setItem('dev_lexicon_terms', JSON.stringify(glossary));
          renderCategories();
          renderTerms();
          alert('Importazione completata!');
        }
      } catch (err) {
        alert('File non valido.');
      }
    };
    reader.readAsText(file);
  }

  function renderTerms(query = '') {
    const listContainer = document.getElementById('termsList');
    const cleanQuery = query.trim().toLowerCase();
    document.getElementById('termCount').innerText = `${glossary.length} termini memorizzati`;

    let filtered = glossary.filter(item => {
      const matchQuery = item.term.toLowerCase().includes(cleanQuery) || 
                         (item.category && item.category.toLowerCase().includes(cleanQuery));
      const matchCat = (selectedCategory === 'ALL' || item.category === selectedCategory);
      return matchQuery && matchCat;
    });

    if (filtered.length === 0 && cleanQuery.length > 0) {
      listContainer.innerHTML = `
        <div class="not-found-box">
          <p>Il termine "<strong>${escapeHtml(query)}</strong>" non è presente nel glossario.</p>
          <button class="btn-search-web" onclick="fetchTermFromWeb('${escapeHtml(query)}')">
            🔍 Cerca e Aggiungi via AI / Web
          </button>
          <div id="fetchLoader"></div>
        </div>
      `;
      return;
    }

    listContainer.innerHTML = filtered.map(item => `
      <div class="term-card">
        <div class="card-header">
          <h2>${escapeHtml(item.term)}</h2>
          <button class="btn-delete" title="Elimina" onclick="deleteTerm('${escapeHtml(item.term)}')">🗑️</button>
        </div>
        <div class="badge-group">
          <span class="category-badge">${escapeHtml(item.category || 'Generale')}</span>
          ${item.autoFetched ? '<span class="new-badge">Web / AI</span>' : ''}
        </div>
        <p class="text-content">
          ${escapeHtml(currentMode === 'summary' ? item.summary : item.detail)}
        </p>
        ${currentMode === 'detail' && item.code ? `
          <div class="code-block">
            <div class="code-header">Esempio Pratico:</div>
            <pre><code>${escapeHtml(item.code)}</code></pre>
          </div>
        ` : ''}
      </div>
    `).join('');
  }

  async function fetchTermFromWeb(searchTerm) {
    const apiKey = localStorage.getItem('gemini_api_key');
    const loader = document.getElementById('fetchLoader');

    if (!apiKey) {
      alert('Inserisci e salva una chiave Gemini API per la ricerca.');
      return;
    }

    loader.innerHTML = `<span class="spinner">Interrogazione e generazione scheda con codice...</span>`;

    const prompt = `Fornisci la spiegazione del termine informatico/sviluppo software: "${searchTerm}".
Rispondi RIGOROSAMENTE ed ESCLUSIVAMENTE con un oggetto JSON valido (senza blocchi markdown \`\`\`json) con questa struttura esatta:
{
  "term": "Nome formale del termine",
  "category": "Categoria (Frontend, Backend, DevOps, Algoritmi, Database, Cloud, Architettura, Sicurezza)",
  "summary": "Spiegazione breve e concisa di massimo 1-2 frasi.",
  "detail": "Spiegazione tecnica dettagliata e approfondita.",
  "code": "Un piccolo frammento di codice (in JS/Python/SQL/Bash o pseudo-codice) che esemplifica il concetto."
}`;

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }]
        })
      });

      const data = await response.json();
      if (data.error) throw new Error(data.error.message);

      let rawText = data.candidates[0].content.parts[0].text;
      rawText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();

      const newTerm = JSON.parse(rawText);
      newTerm.autoFetched = true;

      glossary = glossary.filter(i => i.term.toLowerCase() !== newTerm.term.toLowerCase());
      glossary.unshift(newTerm);
      localStorage.setItem('dev_lexicon_terms', JSON.stringify(glossary));

      renderCategories();
      renderTerms(searchTerm);

    } catch (err) {
      loader.innerHTML = `<p style="color: #ef4444; margin-top: 1rem;">Errore: ${err.message}</p>`;
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  document.getElementById('searchInput').addEventListener('input', (e) => {
    renderTerms(e.target.value);
  });

  renderCategories();
  renderTerms();
</script>

</body>
</html>
